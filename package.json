{
  "name": "haruyuki-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop client for the haruyuki app-server",
  "license": "Apache-2.0",
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "postinstall": "node scripts/materialize-vendor.mjs",
    "check:integration": "bun scripts/integration-check.ts",
    "check:conversations": "bun scripts/conversation-check.ts",
    "vendor:sync": "node scripts/materialize-vendor.mjs",
    "check:approval": "bun scripts/approval-check.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@letta-ai/letta-client": "^1.12.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
