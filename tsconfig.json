{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "haruyuki/app-server-client": [
        "./vendor/haruyuki/types/app-server-client.d.ts"
      ],
      "haruyuki/app-server-protocol": [
        "./vendor/haruyuki/types/types/app-server-protocol.d.ts"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*"
  ]
}
